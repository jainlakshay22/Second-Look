{
  "manifest_version": 3,
  "name": "Second Look",
  "version": "0.2.0",
  "description": "Cross-check ChatGPT answers using your signed-in Gemini account.",
  "action": {
    "default_title": "Second Look",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "selectors.js",
        "context.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "selectors.js",
        "src/gemini/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  }
}
